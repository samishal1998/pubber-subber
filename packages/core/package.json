{
  "name": "@pubber-subber/core",
  "version": "0.0.1",
  "description": "Transport-agnostic pub/sub core: adapter contract, PubSub facade, codecs, errors, and conformance test kit.",
  "keywords": [
    "pubsub",
    "pub-sub",
    "messaging",
    "events",
    "adapter",
    "transport-agnostic",
    "typescript"
  ],
  "homepage": "https://github.com/samishal1998/pubber-subber/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samishal1998/pubber-subber.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/samishal1998/pubber-subber/issues"
  },
  "author": "Sami Mishal",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing/index.d.ts",
        "default": "./dist/testing/index.js"
      },
      "require": {
        "types": "./dist/testing/index.d.cts",
        "default": "./dist/testing/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "vitest": "^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
