{
  "name": "pubber-subber",
  "version": "0.0.0",
  "private": true,
  "description": "Transport-agnostic pub/sub for Node.js with an adapter ecosystem.",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "pnpm -r --filter=\"./packages/*\" build",
    "test": "pnpm -r --filter=\"./packages/*\" test",
    "test:integration": "pnpm -r --filter=\"./packages/*\" test:integration",
    "e2e": "pnpm --filter @pubber-subber/e2e test",
    "bench:memory": "pnpm --filter @pubber-subber/bench bench:memory",
    "bench:redis": "pnpm --filter @pubber-subber/bench bench:redis",
    "bench:pg": "pnpm --filter @pubber-subber/bench bench:pg",
    "typecheck": "pnpm -r --filter=\"./packages/*\" typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && changeset publish",
    "clean": "pnpm -r exec rm -rf dist .tsbuildinfo *.tsbuildinfo coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@changesets/cli": "^2.27.11",
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
