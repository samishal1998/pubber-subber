{
  "name": "@pubber-subber/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "End-to-end conformance tests against real adapter backends via Testcontainers.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:memory": "vitest run test/memory.e2e.test.ts",
